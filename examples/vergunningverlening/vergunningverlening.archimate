<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="Voorbeeld: vergunningverlening" id="id-model-1" version="5.0.0">
  <folder name="Strategy" id="id-folder-strategy" type="strategy">
    <element xsi:type="archimate:Capability" name="Vergunningverlening" id="id-e8d7a6a1-d9fb-4af2-b5fb-e1978c7c5457">
      <documentation>Het geheel van vermogens om vergunningen zorgvuldig en tijdig te verlenen.</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="Aanvraag ontvangen" id="id-504916f4-2797-4802-ad80-46e8199ddf42">
      <documentation>Aanvragen digitaal aannemen, registreren en bevestigen.</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="Toetsen aan regels" id="id-62cae38e-3ca5-485a-a356-f5fb27f4788b">
      <documentation>Een aanvraag beoordelen aan de hand van wet- en regelgeving.</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="Besluit bekendmaken" id="id-5221b03c-732e-4205-b20b-97a4310f8eca">
      <documentation>Het besluit vastleggen, verzenden en publiceren.</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="Toezicht en handhaving" id="id-53f1fd5e-0d38-411c-859b-0cd829a6ca5c">
      <documentation>Controleren of de vergunningvoorwaarden worden nageleefd.</documentation>
    </element>
  </folder>
  <folder name="Business" id="id-folder-business" type="business">
    <element xsi:type="archimate:BusinessActor" name="Aanvrager" id="id-5f4f31a8-c437-4659-a03f-0d4ea862d01d">
      <documentation>Inwoner of bedrijf dat een vergunning aanvraagt.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Vergunning aanvragen" id="id-a82bdec1-5eb8-403e-9a8c-f8683f4165d6">
      <documentation>De dienst waarmee een aanvrager een vergunning aanvraagt.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Aanvraag behandelen" id="id-ee081499-3fa4-4669-b311-162b85252aa1">
      <documentation>Van ontvangst tot besluit.</documentation>
    </element>
  </folder>
  <folder name="Application" id="id-folder-application" type="application">
    <element xsi:type="archimate:ApplicationService" name="Regels toetsen" id="id-b9e0bc48-5183-4878-b472-6a6ed71b6701">
      <documentation>Geautomatiseerde toets van een aanvraag tegen de geldende regels.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Zaaksysteem" id="id-d547ff00-b717-41e7-9f0e-1aea10baa0d5">
      <documentation>Registreert de aanvraag en volgt de behandeling.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Regelservice" id="id-10212016-089c-4d9e-87d3-352e3b235b24">
      <documentation>Voert de machineleesbare regels uit.</documentation>
    </element>
  </folder>
  <folder name="Technology &amp; Physical" id="id-folder-technology" type="technology">
    <element xsi:type="archimate:Node" name="Overheidscloud" id="id-30281ca0-5557-4f85-a6cf-52953cccd79d">
      <documentation>Hostingplatform voor de applicaties.</documentation>
    </element>
  </folder>
  <folder name="Motivation" id="id-folder-motivation" type="motivation">
    <element xsi:type="archimate:Goal" name="Snellere doorlooptijd" id="id-71aee6e3-9b0e-4320-8f7e-cc6233339a45">
      <documentation>Aanvragers krijgen binnen acht weken een besluit.</documentation>
    </element>
  </folder>
  <folder name="Implementation &amp; Migration" id="id-folder-impl" type="implementation_migration"/>
  <folder name="Other" id="id-folder-other" type="other"/>
